{
  "name": "stashboard",
  "private": true,
  "packageManager": "pnpm@10.32.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "format": "pnpm -r format",
    "check": "pnpm -r --if-present lint:check && pnpm -r --if-present format:check && pnpm -r --if-present typecheck",
    "web": "pnpm --filter ./apps/sp-web start",
    "backend": "pnpm --filter ./apps/sp-api start:dev",
    "dev:db": "docker compose -f infrastructure/compose/docker-compose.yml up -d postgres",
    "db:repair-runtime-health-migration": "node scripts/repair-runtime-health-migration.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "pg": "^8.23.1",
    "prisma": "^7.10.1"
  },
  "pnpm": {
    "overrides": {
      "vite@>=7.0.0 <7.3.7": "^7.3.7",
      "@modelcontextprotocol/sdk@<1.32.0": "^1.32.0",
      "undici@>=7.0.0 <7.30.1": "^7.30.1",
      "multer@>=2.0.0 <2.5.0": "^2.5.0"
    }
  }
}
